        "def dls(state, goal, depth, path, visited):\n",
        "    if state == goal:\n",
        "        return list(path)\n",
        "    if depth == 0:\n",
        "        return None\n",
        "\n",
        "    zero = state.index(0)\n",
        "    row = zero // 3\n",
        "    col = zero % 3\n",
        "\n",
        "    moves = []\n",
        "\n",
        "    if row > 0:\n",
        "        moves.append(zero - 3)\n",
        "    if row < 2:\n",
        "        moves.append(zero + 3)\n",
        "    if col > 0:\n",
        "        moves.append(zero - 1)\n",
        "    if col < 2:\n",
        "        moves.append(zero + 1)\n",
        "\n",
        "    for move in moves:\n",
        "        new_state_list = list(state)\n",
        "        new_state_list[zero], new_state_list[move] = new_state_list[move], new_state_list[zero]\n",
        "        new_state = tuple(new_state_list)\n",
        "\n",
        "        if new_state not in visited:\n",
        "            path.append(new_state)\n",
        "            visited.add(new_state)\n",
        "\n",
        "            result = dls(new_state, goal, depth - 1, path, visited)\n",
        "\n",
        "            if result:\n",
        "                return result\n",
        "\n",
        "            visited.remove(new_state)\n",
        "            path.pop()\n",
        "\n",
        "    return None\n",
        "\n",
        "\n",
        "def ids(start, goal):\n",
        "\n",
        "    depth = 0\n",
        "\n",
        "    while True:\n",
        "        path = [start]\n",
        "        visited = {start}\n",
        "        result = dls(start, goal, depth, path, visited)\n",
        "\n",
        "        if result:\n",
        "            return result\n",
        "\n",
        "        depth += 1\n",
        "\n",
