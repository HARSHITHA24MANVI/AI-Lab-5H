        "def dfs(state, goal, visited, path, depth, max_depth):\n",
        "    # Base Case 1: Goal reached\n",
        "    if state == goal:\n",
        "        return path\n",
        "\n",
        "    # Base Case 2: Depth limit hit\n",
        "    if depth >= max_depth:\n",
        "        return None\n",
        "\n",
        "    visited.add(state)\n",
        "\n",
        "    zero = state.index(0)\n",
        "    row = zero // 3\n",
        "    col = zero % 3\n",
        "    moves = []\n",
        "\n",
        "    if row > 0: moves.append(zero - 3)  # Up\n",
        "    if row < 2: moves.append(zero + 3)  # Down\n",
        "    if col > 0: moves.append(zero - 1)  # Left\n",
        "    if col < 2: moves.append(zero + 1)  # Right\n",
        "\n",
        "    for move in moves:\n",
        "        new_state = list(state)\n",
        "        new_state[zero], new_state[move] = new_state[move], new_state[zero]\n",
        "        new_state = tuple(new_state)\n",
        "\n",
        "        if new_state not in visited:\n",
        "            result = dfs(new_state, goal, visited, path + [new_state], depth + 1, max_depth)\n",
        "            if result:\n",
        "                return result\n",
        "\n",
        "    # Backtrack: remove state so other paths can try it\n",
        "    visited.remove(state)\n",
        "    return None\n",
        "\n",
